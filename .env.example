# Used when running Node on the host (docker compose sets its own value for the app container).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/schedule_meet"
# Optional: override the base URL used in participant links (defaults to the request's host).
# BASE_URL="https://schedule-meet.example.com"
# Optional: send invites and reminders straight from the app via Gmail (needs 2-Step Verification and an app
# password from https://myaccount.google.com/apppasswords). Without these, only the ChatGPT prompts are shown.
# GMAIL_USER="you@gmail.com"
# GMAIL_APP_PASSWORD="abcd efgh ijkl mnop"
