# Used when running Node on the host (docker compose sets its own value for the app container).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/schedule_meet"
# Base URL for participant links. Needed in production: daily reminders have no request to take the host from.
# Pages and invites fall back to the request's host; reminders fall back to the Vercel production domain,
# else http://localhost:3000.
# BASE_URL="https://schedule-meet.example.com"
# Gmail account that sends invites and reminders (needs 2-Step Verification and an app password from
# https://myaccount.google.com/apppasswords). Without these, no invites or automatic reminders are sent.
# GMAIL_USER="you@gmail.com"
# GMAIL_APP_PASSWORD="abcd efgh ijkl mnop"
# Vercel only: secret that Vercel Cron sends to /api/cron/reminders. Any long random string.
# CRON_SECRET="..."
